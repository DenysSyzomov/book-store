# Environment variables for the Book Store project.
# Copy this file to `.env` and fill in real values locally.
# NEVER commit `.env` — it is already excluded via .gitignore.
#
# Variables prefixed PUBLIC_ are exposed to client-side code by Astro/Vite.
# Everything else is server-only and must never be imported into a
# client:* island or an inline <script> tag.
#
# PUBLIC_SITE_URL, the two PUBLIC_SUPABASE_* variables, and the two
# PUBLIC_SANITY_* variables are active — SEO (Phase 6), the books
# data-access layer (Phase 7, src/lib/supabase.ts), and the editorial
# content layer (Phase 8, src/lib/sanity.ts) all depend on them.
# SUPABASE_SERVICE_ROLE_KEY and the Sanity write token are not used by
# any code yet — reserved ahead of time for the day a privileged write
# path actually exists, documented now so that strategy is visible
# from day one rather than appearing out of nowhere later.

# --- Public: safe to expose to the browser ---

# The real, final production domain (e.g. https://folio-and-co.com or
# the production Vercel URL) — used to build absolute canonical/Open
# Graph/sitemap URLs (docs/MASTER-PROJECT-SPEC.md §29). Must be set on
# the Production Vercel environment before launch; every other
# environment (local dev, Preview deployments) can leave this unset —
# astro.config.mjs falls back to the dev server's own address.
PUBLIC_SITE_URL=

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# A project id and dataset name are identifiers, not secrets — they're
# visible in the URL of every request to Sanity's CDN regardless, which
# is why the official @sanity/astro integration expects them as
# PUBLIC_* (docs/MASTER-PROJECT-SPEC.md §19). What actually keeps this
# safe is the dataset's own read visibility (public — this project
# never publishes anything a visitor shouldn't already see) combined
# with there being no write token anywhere near client code (see
# SANITY_TOKEN below).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=

# --- Server-only: never expose to the browser ---
SUPABASE_SERVICE_ROLE_KEY=

# Reserved, unused: only needed the day something requires reading
# unpublished drafts (a "preview" mode) or writing to Sanity from
# server code. src/lib/sanity.ts never uses a token today — the
# dataset's public read visibility means none is needed for anything
# this project currently does.
SANITY_TOKEN=

# --- Provided automatically by Vercel — nothing to set here ---
#
# VERCEL_ENV ("production" | "preview" | "development") decides whether
# a build is indexable at all (src/lib/seo.ts's isProductionSite(),
# used by src/components/SEO.astro and src/pages/robots.txt.ts). It's
# injected by Vercel itself for every deployment, so it's listed here
# only for visibility, not as something to fill in. Locally, or on any
# host other than Vercel, it's simply unset — which is treated as
# "not production," the safer default (docs/MASTER-PROJECT-SPEC.md §31:
# staging must not be indexable).
