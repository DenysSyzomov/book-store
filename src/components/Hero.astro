---
// Homepage hero: heading, supporting text, CTA(s) (docs/DESIGN-SYSTEM.md
// "Image and Icon Guidelines" + MASTER-PROJECT-SPEC.md §8). Page-specific
// (only used on "/"), so it lives directly under components/ rather than
// inside ui/ or book/.
import Container from "./ui/Container.astro";
import Button from "./ui/Button.astro";

interface Cta {
  label: string;
  href: string;
}

interface FeatureNote {
  label?: string;
  title?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryCta: Cta;
  secondaryCta?: Cta;
  imageUrl?: string;
  imageAlt?: string;
  /** Floating "Editor's pick" callout over the artwork photo
   * (docs/DESIGN-SYSTEM.md "Hero artwork"). Only rendered when both an
   * image and at least a title are present — it describes the photo,
   * so it has nothing to overlay without one. */
  featureNote?: FeatureNote;
}

const {
  eyebrow,
  title,
  description,
  primaryCta,
  secondaryCta,
  imageUrl,
  imageAlt = "",
  featureNote,
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <Container>
    {/* This div (not Container's own root element) is what actually
       carries Hero's scoped styles below — Astro only attaches a
       component's scoping attribute to elements written literally in
       its own template, not to a child component's root just because
       it received a `class` prop. Passing the flex class straight to
       <Container class="hero__row"> compiles a CSS rule that can never
       match the real DOM node, silently dropping the whole two-column
       layout (see the identical fix in Header.astro, BookSlider.astro,
       and books/[slug].astro). */}
    <div class="hero__row">
      <div class="hero__content" data-reveal>
        {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
        <h1 id="hero-title" class="hero__title">
          {title}
        </h1>
        <p class="hero__description">{description}</p>
        <div class="hero__actions">
          <Button href={primaryCta.href} variant="primary">
            {primaryCta.label}
          </Button>
          {secondaryCta && (
            <Button href={secondaryCta.href} variant="secondary">
              {secondaryCta.label}
            </Button>
          )}
        </div>
      </div>

      <div class="hero__art">
        {imageUrl ? (
          <img src={imageUrl} alt={imageAlt} width="570" height="520" />
        ) : (
          <div class="hero__art-fallback" role="presentation"></div>
        )}

        {imageUrl && featureNote?.title && (
          <div class="hero__feature-note">
            {featureNote.label && (
              <p class="hero__feature-note-label">{featureNote.label}</p>
            )}
            <p class="hero__feature-note-title">{featureNote.title}</p>
          </div>
        )}
      </div>
    </div>
  </Container>
</section>

<style>
  .hero__row {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding-block: var(--space-16);
  }

  .hero__content {
    flex: 1 1 420px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero__eyebrow {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-oxblood);
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 5vw, var(--font-size-2xl));
    line-height: var(--line-height-tight);
    color: var(--color-ink);
  }

  .hero__description {
    max-width: 46ch;
    color: var(--color-muted);
    line-height: var(--line-height-relaxed);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .hero__art {
    position: relative;
    flex: 1 1 420px;
  }

  .hero__art img,
  .hero__art-fallback {
    width: 100%;
    aspect-ratio: 570 / 520;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }

  .hero__art-fallback {
    background-color: var(--color-moss);
  }

  /* Figma places this at left:30px top:420px, width:300px inside the
     570x520 artwork box (docs/DESIGN-SYSTEM.md "Hero artwork") — used
     as percentages of that box, not fixed px, so it stays correctly
     placed as .hero__art scales fluidly with the viewport instead of
     staying pinned to Figma's one fixed canvas width. */
  .hero__feature-note {
    position: absolute;
    left: 5.26%;
    top: 80.77%;
    width: 52.63%;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: var(--space-4);
    background-color: var(--color-surface);
    border-radius: var(--radius-sm);
  }

  .hero__feature-note-label {
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 400;
    text-transform: uppercase;
    color: var(--color-oxblood);
  }

  .hero__feature-note-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-ink);
  }

  @media (max-width: 768px) {
    .hero__row {
      flex-direction: column;
    }
  }
</style>
